# Copiar para .env e ajustar conforme necessário.
# Cada app também possui seu próprio .env.example com as variáveis que consome.

NODE_ENV=development

# Habilita os mock adapters (GitHub/Sentry/Grafana/Slack) e os geradores de dados
# de demonstração, permitindo rodar o Nexus sem credenciais externas (ver Phase 3).
DEMO_MODE=true

DATABASE_URL=postgresql://nexus:nexus@localhost:5432/nexus
JWT_SECRET=change-me-in-production
